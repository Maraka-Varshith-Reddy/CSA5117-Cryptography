#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void generateMatrix(char key[])
{
    int used[26] = {0};
    int i, j, k = 0;

    used['J' - 'A'] = 1;

    for(i = 0; key[i] != '\0'; i++)
    {
        char ch = toupper(key[i]);

        if(ch == 'J')
            ch = 'I';

        if(ch >= 'A' && ch <= 'Z' && !used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for(i = 0; i < 26; i++)
    {
        if(!used[i])
        {
            matrix[k / 5][k % 5] = i + 'A';
            k++;
        }
    }
}

void findPosition(char ch, int *row, int *col)
{
    int i, j;

    if(ch == 'J')
        ch = 'I';

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main()
{
    char key[50], text[100], plain[100];
    int i, j = 0;
    int r1, c1, r2, c2;

    printf("Enter Keyword: ");
    scanf("%s", key);

    generateMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for(i = 0; i < 5; i++)
    {
        int k;
        for(k = 0; k < 5; k++)
            printf("%c ", matrix[i][k]);
        printf("\n");
    }

    printf("\nEnter Plain Text: ");
    scanf("%s", text);

    // Convert to uppercase
    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            plain[j++] = toupper(text[i]);
        }
    }
    plain[j] = '\0';

    // Insert X between repeated letters
    char temp[100];
    int p = 0;

    for(i = 0; i < j; i++)
    {
        temp[p++] = plain[i];

        if(plain[i] == plain[i + 1])
            temp[p++] = 'X';
    }

    temp[p] = '\0';

    if(p % 2 != 0)
    {
        temp[p++] = 'X';
        temp[p] = '\0';
    }

    printf("\nEncrypted Text: ");

    for(i = 0; i < p; i += 2)
    {
        findPosition(temp[i], &r1, &c1);
        findPosition(temp[i + 1], &r2, &c2);

        if(r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1 + 1) % 5],
                   matrix[r2][(c2 + 1) % 5]);
        }
        else if(c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1 + 1) % 5][c1],
                   matrix[(r2 + 1) % 5][c2]);
        }
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    printf("\n");

    return 0;
}